# ============================================================
# ScatterX Enterprise – Environment Variable Template
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ── Application ────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://scatterx:changeme@localhost:5432/scatterx_dev

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NEXTAUTH_SECRET=CHANGE_ME_IN_PRODUCTION
NEXTAUTH_URL=http://localhost:3000

# ── Admin Bootstrap ────────────────────────────────────────
# Used ONLY for the first-run seed. Rotation is enforced after first login.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_BEFORE_SEEDING

# ── Payments ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
GCASH_MERCHANT_ID=CHANGE_ME
GCASH_API_KEY=CHANGE_ME
GCASH_WEBHOOK_SECRET=CHANGE_ME
MAYA_PUBLIC_KEY=pk-CHANGE_ME
MAYA_SECRET_KEY=sk-CHANGE_ME
MAYA_WEBHOOK_SECRET=CHANGE_ME

# ── AI Reward Engine ───────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=CHANGE_ME

# ── Jackpot Service (Go) ───────────────────────────────────
JACKPOT_SERVICE_URL=http://localhost:9000
JACKPOT_SERVICE_API_KEY=CHANGE_ME

# ── Game Server (Rust) ─────────────────────────────────────
GAME_SERVER_URL=http://localhost:9001
GAME_SERVER_API_KEY=CHANGE_ME

# ── Realtime Gateway ───────────────────────────────────────
SOCKET_IO_PORT=3002
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# ── Observability ──────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090

# ── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@scatterx.app

# ── Cloudflare / CDN ───────────────────────────────────────
CLOUDFLARE_ZONE_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
